			<graphicClass>Graphic_FleckPulse</graphicClass>
			<shaderType>MoteCircularSparks</shaderType>
			<shaderParameters>
				<_ExtraTex>/Things/Mote/CollapseSparks_b</_ExtraTex>
				<_texScale>0.50</_texScale>
				<_texAScrollSpeed>-0.50</_texAScrollSpeed>
