    <ThingDef ParentName="RSApparelMakeableBase">
        <defName>Apparel_ReflactorArmor</defName>
        <label>reflector carapace</label>
        <techLevel>Spacer</techLevel>
        <description>Nemesis is high-performance power armor engineered specifically for extermination missions against Federation remnants. With near-total resistance to heat-based weaponry, it's reserved for the most elite of the Tisiphone Hunter Contingent.</description>
        <graphicData>
            <texPath>Things/Apparel/Nemesis</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
        </graphicData>
        <thingCategories>
            <li>RSApparels</li>
        </thingCategories>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <researchPrerequisite>PoweredArmor</researchPrerequisite>
            <recipeUsers Inherit="False">
                <li>SC_table</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>9</Crafting>
            </skillRequirements>
        </recipeMaker>
        <costList>
            <SC_DarkMatterAlloy>4</SC_DarkMatterAlloy>
            <SC_SingularityStones>90</SC_SingularityStones>
        </costList>
        <statBases>
            <Flammability>0.0</Flammability>
            <Mass>13.9</Mass>
            <WorkToMake>175000</WorkToMake>
            <MaxHitPoints>1000</MaxHitPoints>
            <ArmorRating_Sharp>2</ArmorRating_Sharp>
            <ArmorRating_Blunt>2</ArmorRating_Blunt>
            <ArmorRating_Heat>2</ArmorRating_Heat>
            <Insulation_Cold>75</Insulation_Cold>
            <Insulation_Heat>150</Insulation_Heat>
            <EquipDelay>15</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>0.2</MoveSpeed>
            <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.3</VacuumResistance>
        </equippedStatOffsets>
        <apparel>
            <wornGraphicPath>Things/Apparel/Nemesis</wornGraphicPath>
            <layers>
                <li>Middle</li>
                <li>Shell</li>
            </layers>
            <bodyPartGroups>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Torso</li>
                <li>Arms</li>
                <li>Legs</li>
                <li>Hands</li>
                <li>Feet</li>
            </bodyPartGroups>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <tags>
                <li>SpacerMilitary</li>
                <li>Royal</li>
                <li>EVA</li>
            </tags>
        </apparel>
        <comps>

        </comps>
    </ThingDef>

