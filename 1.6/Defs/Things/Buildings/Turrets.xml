        </comps>
        <building>
            <turretGunDef>Gun_SupTurret</turretGunDef>
            <turretBurstWarmupTime>3.2</turretBurstWarmupTime>
            <turretTopDrawSize>2.5</turretTopDrawSize>
        </building>
        <researchPrerequisites>
            <li>FocusTech</li>
        </researchPrerequisites>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>Bullet_SupTurret</defName>
        <label>singularity sphere</label>
        <graphicData>
            <texPath>Things/Projectile/ImpactC</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <thingClass>Projectile_Explosive</thingClass>
